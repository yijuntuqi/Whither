# ============================================================
# Whither 旅行规划助手 — 环境变量模板
# 复制为 .env 并填入实际值（.env 已在 .gitignore 中，不会提交）
# ============================================================

# ===== LLM 大模型 =====
# provider: ollama=本地模型 / openai=OpenAI协议（含 chatanywhere 代理）
LLM_PROVIDER=openai

# OpenAI 协议（chatanywhere 免费代理）
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxx
OPENAI_API_BASE=https://api.chatanywhere.tech/v1
LLM_MODEL=gpt-4o-mini

# Ollama 本地模型（开发用）
# LLM_PROVIDER=ollama
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_MODEL=qwen2.5:7b
# OLLAMA_TEMPERATURE=0.2

# ===== Embedding 向量化 =====
# provider: ollama=本地bge-m3 / dashscope=阿里云DashScope API（部署用）
EMBEDDING_PROVIDER=ollama
EMBED_MODEL=bge-m3

# DashScope（部署时切换）
# EMBEDDING_PROVIDER=dashscope
# DASHSCOPE_API_KEY=sk-xxxxxxxxxxxxxxxxxxxx
# DASHSCOPE_EMBED_MODEL=qwen3.7-text-embedding

# ===== MCP 外部工具 =====
# 高德地图 MCP（景点间交通查询，留空则降级为"建议现场导航"）
AMAP_MCP_URL=https://mcp.amap.com/mcp?key=YOUR_AMAP_KEY

# 12306 MCP 通过 npx 启动，无需额外配置（Docker 中已安装 Node.js）

# ===== Tavily 联网搜索 =====
TAVILY_API_KEY=tvly-xxxxxxxxxxxxxxxxxxxx

# ===== Agent 会话持久化 =====
AGENT_CHECKPOINT_DB=agent_checkpoints.db

# ===== PDF 生成 =====
# 留空则使用 Playwright 自带 Chromium（Docker 中已安装）
# PLAYWRIGHT_EXECUTABLE_PATH=
